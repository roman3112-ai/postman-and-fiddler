{
  "info": {
    "name": "API traffic audit — httpbin",
    "description": "Учебная Postman-коллекция для тренировки функционального и негативного тестирования REST API. Гоняется против публичного httpbin.org (echo-сервис), поэтому безопасно запускать в CI без ключей и стендов. Каждый запрос — отдельный тест-кейс с проверками в разделе Tests (pm.test).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Basic Auth",
      "item": [
        {
          "name": "Успешная авторизация",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "basic",
              "basic": [
                {"key": "username", "value": "qa_user", "type": "string"},
                {"key": "password", "value": "qa_pass", "type": "string"}
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/basic-auth/qa_user/qa_pass",
              "host": ["{{baseUrl}}"],
              "path": ["basic-auth", "qa_user", "qa_pass"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Тело подтверждает авторизацию', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.authenticated).to.eql(true);",
                  "    pm.expect(body.user).to.eql('qa_user');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Неверный пароль (негативный тест)",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "basic",
              "basic": [
                {"key": "username", "value": "qa_user", "type": "string"},
                {"key": "password", "value": "wrong_pass", "type": "string"}
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/basic-auth/qa_user/qa_pass",
              "host": ["{{baseUrl}}"],
              "path": ["basic-auth", "qa_user", "qa_pass"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 401 при неверном пароле', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('Есть заголовок WWW-Authenticate', function () {",
                  "    pm.response.to.have.header('WWW-Authenticate');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - CRUD (echo)",
      "item": [
        {
          "name": "Создание пользователя (POST)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Roman\",\n    \"job\": \"QA Engineer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/anything/users",
              "host": ["{{baseUrl}}"],
              "path": ["anything", "users"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Сервер вернул тот же JSON и метод POST', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.method).to.eql('POST');",
                  "    pm.expect(body.json.name).to.eql('Roman');",
                  "    pm.expect(body.json.job).to.eql('QA Engineer');",
                  "});",
                  "",
                  "// сохраняем имя в переменные окружения — пригодится в PUT-запросе (chaining)",
                  "pm.environment.set('lastUserName', pm.response.json().json.name);"
                ]
              }
            }
          ]
        },
        {
          "name": "Обновление пользователя (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"{{lastUserName}}\",\n    \"job\": \"Senior QA Engineer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/anything/users/1",
              "host": ["{{baseUrl}}"],
              "path": ["anything", "users", "1"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Метод PUT и имя из предыдущего запроса подставились', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.method).to.eql('PUT');",
                  "    pm.expect(body.json.name).to.eql(pm.environment.get('lastUserName'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Удаление пользователя (DELETE)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/anything/users/1",
              "host": ["{{baseUrl}}"],
              "path": ["anything", "users", "1"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 200 и метод DELETE', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().method).to.eql('DELETE');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
