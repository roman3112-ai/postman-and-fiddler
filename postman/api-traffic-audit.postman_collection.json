    },
    {
      "name": "04 - Заголовки и cookies",
      "item": [
        {
          "name": "Security-заголовки в ответе",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/response-headers?X-Frame-Options=DENY&X-Content-Type-Options=nosniff",
              "host": ["{{baseUrl}}"],
              "path": ["response-headers"],
              "query": [
                {"key": "X-Frame-Options", "value": "DENY"},
                {"key": "X-Content-Type-Options", "value": "nosniff"}
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('X-Frame-Options проставлен верно', function () {",
                  "    pm.expect(pm.response.headers.get('X-Frame-Options')).to.eql('DENY');",
                  "});",
                  "",
                  "pm.test('X-Content-Type-Options проставлен верно', function () {",
                  "    pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Установка cookie",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cookies/set/session_id/abc123",
              "host": ["{{baseUrl}}"],
              "path": ["cookies", "set", "session_id", "abc123"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('После редиректа сервер подтвердил cookie', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().cookies.session_id).to.eql('abc123');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Cookie сохраняется между запросами",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cookies",
              "host": ["{{baseUrl}}"],
              "path": ["cookies"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('cookie jar сам подставил ранее установленную куку', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().cookies.session_id).to.eql('abc123');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05 - Негативные сценарии",
      "item": [
