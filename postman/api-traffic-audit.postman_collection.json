          "name": "POST без обязательного заголовка Content-Type",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "не-JSON строка вместо тела запроса"
            },
            "url": {
              "raw": "{{baseUrl}}/anything/users",
              "host": ["{{baseUrl}}"],
              "path": ["anything", "users"]
            }
          },
          "response": [],
          "event": [
